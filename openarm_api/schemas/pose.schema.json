{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "openarm_api/pose.schema.json",
  "title": "6-DoF pose in robot base frame",
  "type": "object",
  "required": ["xyz", "rpy"],
  "additionalProperties": false,
  "properties": {
    "xyz":   { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3,
               "description": "Position in metres (x, y, z)" },
    "rpy":   { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3,
               "description": "Orientation as roll, pitch, yaw in radians" },
    "frame": { "type": "string", "default": "base_link" }
  }
}
