{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "openarm_api/hand_water.schema.json",
  "title": "hand_water params",
  "description": "Pick from behind and move to front hover (place.approach). Arm holds position with gripper closed; no auto-release or return home.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "speed_scale":    { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0, "default": 0.10 },
    "gripper_force":  { "type": "number", "minimum": 0.0, "default": 8.0 },
    "gripper_speed":  { "type": "number", "minimum": 0.0, "default": 0.3 }
  }
}
