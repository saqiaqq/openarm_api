{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "openarm_api/pick_place.schema.json",
  "title": "pick_place params",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_name":       { "type": "string" },
    "target_index":      { "type": "integer", "minimum": 0, "default": 0 },
    "grasp_pose":        { "$ref": "openarm_api/pose.schema.json" },
    "place_pose":        { "$ref": "openarm_api/pose.schema.json" },
    "approach_offset_m": { "type": "number", "minimum": 0.0, "maximum": 0.5, "default": 0.05 },
    "retreat_offset_m":  { "type": "number", "minimum": 0.0, "maximum": 0.5, "default": 0.05 },
    "speed_scale":       { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0, "default": 0.10 },
    "target_radius":     { "type": "number", "minimum": 0.0, "maximum": 0.5, "default": 0.0,
                           "description": "Object bounding-sphere (m): avoided at pick.approach (grasp center) and place.retreat (place center); not used during transport." },
    "gripper_force":     { "type": "number", "minimum": 0.0, "maximum": 40.0, "default": 0.0,
                           "description": "Optional gripper force/hold strength during grasp; 0 uses controller default." },
    "gripper_speed":     { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0,
                           "description": "Optional gripper speed scale during grasp; 0 uses default." }
  },
  "allOf": [
    {
      "if":  { "$ref": "openarm_api/envelope.schema.json#/properties/pose_source", "const": "upper_computer" },
      "then": { "required": ["grasp_pose", "place_pose"] }
    }
  ]
}
